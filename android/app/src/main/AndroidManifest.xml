<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- allowBackup="false": ilova WebView xotirasida Firebase Auth sessiya
         tokenini saqlaydi. Avtomatik zaxira yoqilgan bo'lsa, bu token Google
         Drive'ga nusxalanib, boshqa qurilmada tiklanishi mumkin edi.
         Moliyaviy ma'lumot bilan ishlovchi ilova uchun zaxira o'chiriladi. -->
    <application
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <!-- AdMob ilova identifikatori. Bu meta-data BO'LISHI SHART: Google
             Mobile Ads SDK uni ishga tushishda o'qiydi va topolmasa ilovani
             darrov yiqitadi ("The Google Mobile Ads SDK was initialized
             without an application ID"). Reklama birligi (Ad Unit) ID'si esa
             bu yerda emas — u JS tomonda, ADMOB_REWARD_UNIT da. -->
        <meta-data
            android:name="com.google.android.gms.ads.APPLICATION_ID"
            android:value="ca-app-pub-3843970093238957~8554865131" />

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
</manifest>
