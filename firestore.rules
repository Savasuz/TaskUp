rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Admin ekanligini admins/{uid} hujjati borligi orqali tekshiramiz
    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    // Admin ro'yxati: har kim faqat o'z hujjatini o'qiy oladi.
    match /admins/{uid} {
      allow read: if isOwner(uid);
      allow write: if false;
    }

    // Vazifalar katalogi: o'qish — tizimga kirganlarga, yozish — faqat adminlarga.
    match /tasks/{taskId} {
      allow read: if request.auth != null;
      allow create, update, delete: if isAdmin();
    }

    // Yangiliklar: o'qish — tizimga kirganlarga, yozish — faqat adminlarga.
    match /news/{newsId} {
      allow read: if request.auth != null;
      allow create, update, delete: if isAdmin();
    }

    // Promo kodlar: faqat admin boshqaradi; foydalanuvchi server (Cloud Function) orqali ishlatadi.
    match /promo_codes/{codeId} {
      allow read: if isAdmin();
      allow create, update, delete: if isAdmin();
    }

    // Qurilmalar reyestri (multi-akkaunt nazorati): yozish faqat server orqali.
    match /devices/{deviceId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Foydalanuvchi profili — ANTI-CHEAT:
    // tanga maydonlarini (coins, lifetimeCoins, cashedOutTotal, dailyEarned...)
    // faqat server (Cloud Functions, Admin SDK) va admin o'zgartira oladi.
    match /users/{uid} {
      allow read: if isOwner(uid) || isAdmin();

      // Yangi hisob faqat nol balans bilan ochiladi
      allow create: if isOwner(uid)
        && request.resource.data.coins == 0
        && request.resource.data.lifetimeCoins == 0
        && request.resource.data.cashedOutTotal == 0
        && request.resource.data.dailyEarned == 0;

      // XAVFSIZLIK: kunlik hisoblagichlarni (taskCounts, dailyEarned, lastReset)
      // egasi O'ZGARTIRA OLMAYDI.
      // Avval bu qoida egasiga ularni nolga tushirishga ruxsat berardi ("yangi kun"
      // resetini mijoz bajarardi). Lekin qoida resetni FAQAT kun almashganda emas,
      // ISTALGAN VAQTDA bajarishga imkon berardi: foydalanuvchi brauzer konsolidan
      // hisoblagichlarni qayta-qayta nolga tushirib, har bir vazifaning kunlik
      // limitini ham, umumiy kunlik daromad chegarasini ham cheklovsiz aylanib
      // o'tishi mumkin edi (completeTask aynan shu maydonlarga ishonadi).
      // Kun almashinuvi serverda — completeTask tranzaksiyasi ichida — bajariladi,
      // shuning uchun mijozning yozishiga ehtiyoj yo'q.
      allow update: if isAdmin();

      // Egasi profil rasmi havolasini (avatarUrl) mustaqil yangilay oladi -
      // pul/anti-cheat maydonlariga aloqasi yo'q, shu sabab alohida qoida.
      allow update: if isOwner(uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['avatarUrl'])
        && request.resource.data.avatarUrl is string
        && request.resource.data.avatarUrl.size() < 500;

      allow delete: if isAdmin();

      // Tarix: yozish faqat server/admin orqali (mukofotlar serverda yoziladi)
      match /history/{entryId} {
        allow read: if isOwner(uid) || isAdmin();
        allow write: if isAdmin();
      }

      // Vazifa progressi: { count, lastResetDate, repeat, updatedAt }.
      // Egasi faqat O'QIY oladi — yozish completeTask/verifyTelegram/AdMob SSV
      // tranzaksiyalari ichida bo'ladi. Mijozga yozishga ruxsat berilsa,
      // hisoblagichni nolga tushirib kunlik limitni cheklovsiz aylanib
      // o'tish mumkin bo'lardi (taskCounts bilan aynan shu xato bo'lgan).
      match /taskProgress/{taskId} {
        allow read: if isOwner(uid) || isAdmin();
        allow write: if false;
      }
    }

    // Pul yechish so'rovlari: yaratish FAQAT server (Cloud Function) orqali.
    match /cashout_requests/{reqId} {
      allow create: if false;
      allow read: if isAdmin() || (request.auth != null && resource.data.uid == request.auth.uid);
      allow update, delete: if isAdmin();
    }
  }
}
