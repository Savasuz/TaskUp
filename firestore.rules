rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Admin ekanligini admins/{uid} hujjati borligi orqali tekshiramiz
    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    // Admin ro'yxati: har kim faqat o'z hujjatini o'qiy oladi.
    match /admins/{uid} {
      allow read: if isOwner(uid);
      allow write: if false;
    }

    // Vazifalar katalogi: o'qish — tizimga kirganlarga, yozish — faqat adminlarga.
    match /tasks/{taskId} {
      allow read: if request.auth != null;
      allow create, update, delete: if isAdmin();
    }

    // Yangiliklar: o'qish — tizimga kirganlarga, yozish — faqat adminlarga.
    match /news/{newsId} {
      allow read: if request.auth != null;
      allow create, update, delete: if isAdmin();
    }

    // Promo kodlar: faqat admin boshqaradi; foydalanuvchi server (Cloud Function) orqali ishlatadi.
    match /promo_codes/{codeId} {
      allow read: if isAdmin();
      allow create, update, delete: if isAdmin();
    }

    // Qurilmalar reyestri (multi-akkaunt nazorati): yozish faqat server orqali.
    match /devices/{deviceId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Telegram hisobi -> uid teskari indeksi. Bitta Telegram akkaunti
    // ko'p TaskUp hisobiga bog'lanmasligini ta'minlaydi, shuning uchun
    // mijoz uni na o'qiy, na o'zgartira oladi — faqat telegramWebhook
    // (Admin SDK) yozadi.
    match /telegram_links/{telegramId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Foydalanuvchi profili — ANTI-CHEAT:
    // tanga maydonlarini (coins, lifetimeCoins, cashedOutTotal, dailyEarned...)
    // faqat server (Cloud Functions, Admin SDK) va admin o'zgartira oladi.
    match /users/{uid} {
      allow read: if isOwner(uid) || isAdmin();

      /* Yangi hisob. Avval bu yerda FAQAT to'rtta pul maydoni nolligi
         tekshirilardi, qolgan hamma maydonni foydalanuvchi o'zi belgilay
         olardi. Ilova ularni nol bilan yozadi, lekin hujum ilova orqali
         emas — SDK'dan to'g'ridan-to'g'ri bajariladi: ro'yxatdan o'tib,
         hujjatni o'zi yaratadi. Shu yo'l bilan mumkin bo'lgan narsalar:

           tasksCompletedTotal: 100  -> uchala sandiq darrov = 2300 tanga
           weeklyCoins: 999999       -> haftalik TOP-1 mukofoti
           telegramId: <birovniki>   -> Telegram vazifasini a'zo bo'lmay olish
           referralCode: <birovniki> -> referal bonuslarini o'g'irlash
           claimedMilestones / streakCount / friendsBonus — erkin

         Endi ruxsat etilgan maydonlar ro'yxati va ularning boshlang'ich
         qiymatlari qat'iy belgilangan. Yangi maydon qo'shilsa shu ro'yxatga
         ham qo'shilishi kerak, aks holda ro'yxatdan o'tish ishlamay qoladi. */
      allow create: if isOwner(uid)
        && request.resource.data.keys().hasOnly([
             'email', 'coins', 'lifetimeCoins', 'taskCounts', 'tasksCompletedTotal',
             'dailyEarned', 'friendsCount', 'friendsBonus', 'cashedOutTotal',
             'streakCount', 'lastStreakClaim', 'lastReset', 'referralCode', 'createdAt'
           ])
        && request.resource.data.coins == 0
        && request.resource.data.lifetimeCoins == 0
        && request.resource.data.cashedOutTotal == 0
        && request.resource.data.dailyEarned == 0
        && request.resource.data.tasksCompletedTotal == 0
        && request.resource.data.friendsCount == 0
        && request.resource.data.friendsBonus == 0
        && request.resource.data.streakCount == 0
        && request.resource.data.taskCounts.size() == 0
        && request.resource.data.lastStreakClaim == null
        && request.resource.data.email is string
        && request.resource.data.email.size() < 200
        // Referal kodi uid'dan kelib chiqadi — birovnikini qo'yib bo'lmaydi
        && request.resource.data.referralCode == 'TASKUP-' + uid[uid.size()-6:uid.size()].upper();

      // XAVFSIZLIK: kunlik hisoblagichlarni (taskCounts, dailyEarned, lastReset)
      // egasi O'ZGARTIRA OLMAYDI.
      // Avval bu qoida egasiga ularni nolga tushirishga ruxsat berardi ("yangi kun"
      // resetini mijoz bajarardi). Lekin qoida resetni FAQAT kun almashganda emas,
      // ISTALGAN VAQTDA bajarishga imkon berardi: foydalanuvchi brauzer konsolidan
      // hisoblagichlarni qayta-qayta nolga tushirib, har bir vazifaning kunlik
      // limitini ham, umumiy kunlik daromad chegarasini ham cheklovsiz aylanib
      // o'tishi mumkin edi (completeTask aynan shu maydonlarga ishonadi).
      // Kun almashinuvi serverda — completeTask tranzaksiyasi ichida — bajariladi,
      // shuning uchun mijozning yozishiga ehtiyoj yo'q.
      allow update: if isAdmin();

      // Egasi profil rasmi havolasini (avatarUrl) mustaqil yangilay oladi -
      // pul/anti-cheat maydonlariga aloqasi yo'q, shu sabab alohida qoida.
      allow update: if isOwner(uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['avatarUrl'])
        && request.resource.data.avatarUrl is string
        && request.resource.data.avatarUrl.size() < 500;

      allow delete: if isAdmin();

      // Tarix: yozish faqat server/admin orqali (mukofotlar serverda yoziladi)
      match /history/{entryId} {
        allow read: if isOwner(uid) || isAdmin();
        allow write: if isAdmin();
      }

      // Vazifa progressi: { count, lastResetDate, repeat, updatedAt }.
      // Egasi faqat O'QIY oladi — yozish completeTask/verifyTelegram/AdMob SSV
      // tranzaksiyalari ichida bo'ladi. Mijozga yozishga ruxsat berilsa,
      // hisoblagichni nolga tushirib kunlik limitni cheklovsiz aylanib
      // o'tish mumkin bo'lardi (taskCounts bilan aynan shu xato bo'lgan).
      match /taskProgress/{taskId} {
        allow read: if isOwner(uid) || isAdmin();
        allow write: if false;
      }
    }

    // Pul yechish so'rovlari: yaratish FAQAT server (Cloud Function) orqali.
    match /cashout_requests/{reqId} {
      allow create: if false;
      allow read: if isAdmin() || (request.auth != null && resource.data.uid == request.auth.uid);
      allow update, delete: if isAdmin();
    }
  }
}
